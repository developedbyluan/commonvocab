{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "commonvocab",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-24",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "commonvocab",
			"database_id": "c8f0e8d8-7bcc-4748-aeec-a21804330850"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"ratelimits": [
		{
			"name": "LOOKUP_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "ENTRIES_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "CHAT_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	// "vars": {
	//   "MY_VAR": "my-variable"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// }
}